# EditorConfig: https://editorconfig.org
#
# root = true stops lookup here, so this overrides ~/.editorconfig. The [*.rs]
# section matches rustfmt's defaults (4-space indent, 100-col width) — rustfmt
# does not read this file, so the editor must match it, not vice versa.
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4
max_line_length = 100

[*.toml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[justfile]
indent_size = 4

[Makefile]
indent_style = tab
