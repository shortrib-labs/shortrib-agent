# Slack socket-mode credentials
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

# OpenAI model access
OPENAI_API_KEY=...

# Public URL registered during Google Calendar OAuth. In production, route
# this URL to GOOGLE_CALENDAR_MCP_CALLBACK_BIND on the single running replica.
GOOGLE_CALENDAR_MCP_REDIRECT_URI=https://agent.example.com/oauth/callback
GOOGLE_CALENDAR_MCP_CALLBACK_BIND=0.0.0.0:3000

# Optional override; the production Calendar MCP endpoint is the default.
# GOOGLE_CALENDAR_MCP_URL=https://google-calendar-mcp-hrlw48pl49z9x55u3a2kremvhe.mcp.gateway.context.cloud/mcp/v1

# Enable encrypted OAuth credential persistence. Generate the key once with
# `openssl rand -base64 32`, store it in a secret manager, and keep it stable
# across restarts. The directory must be on a durable private volume.
GOOGLE_CALENDAR_OAUTH_STORAGE_DIR=./data/oauth
GOOGLE_CALENDAR_OAUTH_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Deterministic Slack App Home. Create confidential and public Keycard
# applications with the same Google Calendar dependency. Route the public
# redirect URI to the callback bind on this process; see docs/slack-app-home.md.
KEYCARD_ISSUER=https://YOUR_ZONE.keycard.cloud
KEYCARD_CLIENT_ID=...
KEYCARD_CLIENT_SECRET=...
KEYCARD_CALENDAR_PUBLIC_CLIENT_ID=...
KEYCARD_CALENDAR_REDIRECT_URI=https://agent.example.com/calendar/callback
KEYCARD_CALENDAR_CALLBACK_BIND=0.0.0.0:3001
